# URL to the oai server
oaipmh.url=
search.api.url=

##dataset serving url
dataset.serving.url=

## keycloak endpoint for access
europeana.apikey.serviceurl =
keycloak.token.endpoint =
keycloak.token.grant.params =

#Location of the dataset files
dataset.files.location=
snapshot.file=datasets_snapshot.txt

slack.webhook=

## Can be set to ALL/all for a force harvest of all datasets. Also specific datasets can be set here. Example : 1533, 536, 1514, 1524
dataset.to.harvest=


## The number of threads to use for harvesting
##The core pool size says a thread pool executor will start with N number of threads.
##A throttle-limit T says that, regardless of the number of threads available in the thread pool,
##only use T of those threads for a tasklet.
## throttle limit can not exceed the max core pool size.

batch.step.updates.executor.corePool=
batch.step.updates.throttleLimit=
batch.step.updates.executor.maxPool=

## With a multithreaded Spring Batch step, a queue capacity of 0
# (or a very small value) tends to give better throughput because
# tasks are handed directly to worker threads instead of accumulating
# in the executor queue. Default value is set to 0
batch.step.updates.executor.queueSize=

## If LIST-based processing, please use chunk size = 1 (as we have custom atomic reader)
## If JDBC-based processing, please use chunk size = 10–50 (as we have use JdbcPagingItemReader)
batch.step.chunkSize=1

## progress logger log interval
log.interval=

## the type of reader dataset api will use. Values are JDBC and LIST. By default LIST is used
spring.batch.reader=LIST